# Copy this file to ".env" (same folder as pom.xml) and edit the values.
# Never commit .env to Git. Do not wrap values in quotes.

# --- MySQL ---
DB_URL=jdbc:mysql://localhost:3306/nexora_ai?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=@9823625426

# --- Security ---
# Long random string; used to encrypt provider API keys stored in the database.
# If empty, a random key is generated once and saved in ./.nexora-secret
APP_ENCRYPTION_KEY=

# --- Server ---
SERVER_PORT=8080
UPLOAD_DIR=./uploads

# --- Default AI provider (created for each new user) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Web search: wikipedia (no setup) | searxng | brave ---
SEARCH_PROVIDER=wikipedia
SEARXNG_URL=http://localhost:8888
BRAVE_API_KEY=
